# Start from an explicit allowlist, including when egg-info already exists.
global-exclude *
include pyproject.toml README.md LICENSE MANIFEST.in AGENTS.md start-studio.sh
include CHANGELOG.md CONTRIBUTING.md
include .editorconfig .gitattributes
recursive-include scout *.py *.svg *.ico py.typed
recursive-include docs *.md
recursive-include tests *.py
recursive-include scripts *.py *.sh
recursive-include packaging *.py *.spec *.iss *.txt *.md
include .codex/config.toml
recursive-include .codex/agents *.toml
include .github/workflows/tests.yml
include .github/workflows/installers.yml
include .github/workflows/promote-installers.yml
# User libraries, configuration, trained models and generated/editor files
# are deliberately absent. Bytecode must never enter either artifact.
global-exclude *.py[cod] *~ *.bak *.swp *.swo .DS_Store
prune **/__pycache__

# Deliberate decision-model catalogue, never arbitrary models/ contents.
include models/catalog.json models/README.md
include models/scout-reviewed-precision/0.4.0/manifest.json
include models/scout-reviewed-precision/0.4.0/classifier.json
include models/person-transformer/1.0.0/pipeline.json
include models/person-transformer/1.0.0/head.onnx
